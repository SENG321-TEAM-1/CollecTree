# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Never commit .env. It is listed in .gitignore.

# ---------------------------------------------------------------- Database (PostgreSQL)
# Used by Docker Compose to create the database and by the backend to connect to it.
POSTGRES_DB=collectree
POSTGRES_USER=collectree
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://collectree:change-me@db:5432/collectree

# ---------------------------------------------------------------- Authentication (JWT)
# Secret used to sign login tokens. Use a long random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Minutes until a login token expires.
JWT_EXPIRE_MINUTES=60

# ---------------------------------------------------------------- Market prices
# Which price provider the daily price job uses:
#   seed = prices from the seed file (default; used in tests and when eBay is not available)
#   ebay = eBay Browse API (needs the eBay keys below)
PRICE_PROVIDER=seed

# eBay Developers Program keyset (Application Keys page).
# EBAY_ENVIRONMENT is "sandbox" (test data) or "production" (real listings).
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# ---------------------------------------------------------------- Exchange rate
# Daily USD to TRY rate published by the Central Bank of the Republic of Turkey.
TCMB_RATES_URL=https://www.tcmb.gov.tr/kurlar/today.xml
